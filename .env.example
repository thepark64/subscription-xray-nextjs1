# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only - never expose

# Razorpay (Dashboard -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=                  # starts with rzp_test_ or rzp_live_
RAZORPAY_KEY_SECRET=              # server only - never expose

# Razorpay (Dashboard -> Webhooks) - the secret you type when creating the webhook
RAZORPAY_WEBHOOK_SECRET=
